<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.mahirexpress.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_customerHome"
            app:destination="@id/customerHomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_adminHome"
            app:destination="@id/adminHomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_managerHome"
            app:destination="@id/managerHomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.mahirexpress.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_customerHome"
            app:destination="@id/customerHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_adminHome"
            app:destination="@id/adminHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_managerHome"
            app:destination="@id/managerHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.mahirexpress.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/customerHomeFragment"
        android:name="com.example.mahirexpress.ui.customer.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_routeList"
            app:destination="@id/routeListFragment" />
        <action
            android:id="@+id/action_home_to_myBookings"
            app:destination="@id/myBookingsFragment" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_global_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/routeListFragment"
        android:name="com.example.mahirexpress.ui.customer.RouteListFragment"
        android:label="Routes"
        tools:layout="@layout/fragment_route_list">
        <argument android:name="source" app:argType="string" />
        <argument android:name="destination" app:argType="string" />
        <argument android:name="date" app:argType="string" />
        <action
            android:id="@+id/action_routeList_to_seatSelection"
            app:destination="@id/seatSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/seatSelectionFragment"
        android:name="com.example.mahirexpress.ui.customer.SeatSelectionFragment"
        android:label="Select Seats"
        tools:layout="@layout/fragment_seat_selection">
        <argument android:name="routeId" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminHomeFragment"
        android:name="com.example.mahirexpress.ui.admin.AdminHomeFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_home" />

    <fragment
        android:id="@+id/managerHomeFragment"
        android:name="com.example.mahirexpress.ui.manager.ManagerHomeFragment"
        android:label="Manager Dashboard"
        tools:layout="@layout/fragment_manager_home" />

    <fragment
        android:id="@+id/myBookingsFragment"
        android:name="com.example.mahirexpress.ui.customer.MyBookingsFragment"
        android:label="My Bookings" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.mahirexpress.ui.customer.ProfileFragment"
        android:label="Profile" />

</navigation>